rules_version = '2';

// Reglas de seguridad de Firestore.
// Todo lo que NO coincide con un `match` de abajo queda DENEGADO por defecto.
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuario solo puede leer y escribir SUS propios datos,
    // donde {uid} debe ser su propio id de sesión.

    // Pendientes
    match /users/{uid}/tasks/{taskId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Actividades constantes (medicación, hábitos…)
    match /users/{uid}/routines/{routineId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Rachas (hábitos estilo Duolingo: ejercicio, agua…)
    match /users/{uid}/streaks/{streakId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Perfil (nombre, avatar, colores, tema…)
    match /users/{uid}/profile/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
