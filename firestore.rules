rules_version = '2';

// Reglas de seguridad de Firestore.
// Todo lo que NO coincide con un `match` de abajo queda DENEGADO por defecto.
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuario solo puede leer y escribir SUS propios pendientes:
    // users/{uid}/tasks/{taskId}, donde {uid} debe ser su propio id de sesión.
    match /users/{uid}/tasks/{taskId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
